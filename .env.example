# Copy to .env; never share the real .env file.
OPENAI_API_KEY=PASTE_API_KEY_HERE
# MODEL[:EFFORT], or none to disable summaries.
# In all mode this also selects fusion; none leaves fusion on Sol medium.
SCRIBE_SUMMARIZE_MODEL=gpt-6.1-sol:medium
# Summary levels 1-10, separated by commas or spaces. Multiple levels write HTML.
# --summary-detail overrides this value at runtime.
SCRIBE_SUMMARY_DETAIL=1,3,5,10
