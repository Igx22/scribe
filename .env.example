# Copy to .env; never share the real .env file.
OPENAI_API_KEY=PASTE_API_KEY_HERE
# MODEL[:EFFORT], or none to disable HTML reports.
# In combined mode this also selects fusion; none leaves fusion on Sol medium.
SCRIBE_SUMMARIZE_MODEL=gpt-6.1-sol:medium
# HTML report tabs: summary levels 1-10 and/or transcript, separated by commas or spaces.
# --report-tabs overrides this value at runtime.
SCRIBE_REPORT_TABS=1,3,5,10,transcript
