# Copy to .env; never share the real .env file.
OPENAI_API_KEY=PASTE_API_KEY_HERE
# MODEL[:EFFORT], or none to disable HTML reports.
# Also selects final GPT reconciliation in every ordinary mode.
# none disables reports; reconciliation still uses Sol medium unless --offline.
SCRIBE_SUMMARIZE_MODEL=gpt-6.2-astra:xhigh
# HTML summary levels 1-10, separated by commas or spaces. HTML includes the transcript.
# --report-tabs overrides this value at runtime.
SCRIBE_REPORT_TABS=1,3,5,10
